diff --git a/test/shell.d/screensaver-live-test.sh b/test/shell.d/screensaver-live-test.sh
new file mode 100755
index 000000000..e16354a81
--- /dev/null
+++ b/test/shell.d/screensaver-live-test.sh
@@ -0,0 +1,53 @@
+#!/bin/bash
+
+# The launcher hands the screensaver to omarchy-ambient when a live one is
+# chosen, and keeps the stock text screensaver otherwise.
+
+set -euo pipefail
+
+source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/base-test.sh"
+
+tmpdir=$(mktemp -d)
+trap 'rm -rf "$tmpdir"' EXIT
+mkdir -p "$tmpdir/bin"
+
+# The stock path is cut short at the terminal check, so reaching it shows up
+# as a notification instead of terminals opening.
+printf '#!/bin/bash\nexit 1\n' >"$tmpdir/bin/pgrep"
+printf '#!/bin/bash\nexit 1\n' >"$tmpdir/bin/omarchy-toggle-enabled"
+printf '#!/bin/bash\necho DP-1\n' >"$tmpdir/bin/omarchy-hyprland-monitor-focused"
+printf '#!/bin/bash\necho unsupported.desktop\n' >"$tmpdir/bin/xdg-terminal-exec"
+printf '#!/bin/bash\necho stock >>"$TEST_DIR/calls"\n' >"$tmpdir/bin/omarchy-notification-send"
+cat >"$tmpdir/bin/omarchy-ambient" <<'SH'
+#!/bin/bash
+if [[ $* == "screensaver --get" ]]; then
+  cat "$TEST_DIR/selected"
+else
+  echo "ambient $*" >>"$TEST_DIR/calls"
+fi
+SH
+chmod +x "$tmpdir/bin/"*
+
+launch() {
+  : >"$tmpdir/calls"
+  PATH="$tmpdir/bin:$ROOT/bin:/usr/bin:/bin" TEST_DIR="$tmpdir" timeout 10 "$ROOT/bin/omarchy-launch-screensaver" "$@" || true
+  cat "$tmpdir/calls"
+}
+
+echo amiga >"$tmpdir/selected"
+[[ $(launch) == "ambient screensaver" ]] || fail "a live screensaver runs through omarchy-ambient" "$(launch)"
+pass "a live screensaver runs through omarchy-ambient"
+
+[[ $(launch force) == "ambient screensaver" ]] || fail "Preview runs the live screensaver too" "$(launch force)"
+pass "Preview runs the live screensaver too"
+
+[[ $(launch force text) == "stock" ]] || fail "force text still runs the stock screensaver" "$(launch force text)"
+pass "force text still runs the stock screensaver"
+
+echo text >"$tmpdir/selected"
+[[ $(launch) == "stock" ]] || fail "with Text Effects chosen the stock screensaver runs" "$(launch)"
+pass "with Text Effects chosen the stock screensaver runs"
+
+rm "$tmpdir/bin/omarchy-ambient"
+[[ $(launch) == "stock" ]] || fail "without omarchy-ambient the stock screensaver runs" "$(launch)"
+pass "without omarchy-ambient the stock screensaver runs"
