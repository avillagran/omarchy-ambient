+    && defaultById['install.style.ambient'].disabled === 'omarchy-pkg-present omarchy-ambient'
+    && defaultById['remove.ambient'].action.endsWith(' omarchy-remove-ambient')
+    && defaultById['remove.ambient'].when === 'omarchy-pkg-present omarchy-ambient',
+  'omarchy-ambient installs from Install > Style and removes from Remove')
+assert(/icon: \(value === current\) \? "✓" : \(parts\[4\] \|\| spec\.icon \|\| ""\)/.test(menuQml),
