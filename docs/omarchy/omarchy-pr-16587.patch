@@ -681,6 +681,24 @@ assert(
   /"fonts": \{[\s\S]*?volatile: true/.test(providerBlock),
   'menu re-enumerates the font list every time it is opened'
 )
+// Live backgrounds and screensavers are omarchy-bg-live sources: the rows
+// list whatever it has installed, and picking one hands it the source id.
+for (const [key, list, action] of [
+  ['background-sources', 'omarchy-bg-live list background', 'omarchy-bg-live start '],
+  ['screensaver-sources', 'omarchy-bg-live list screensaver', 'omarchy-bg-live screensaver --set ']
+]) {
+  const block = (providerBlock.match(new RegExp(`"${key}": \\{[\\s\\S]*?\\n    \\}`)) || [''])[0]
+  assert(block.includes(`command -v omarchy-bg-live >/dev/null && ${list}`) && /volatile: true/.test(block) && block.includes(`"${action}" + Util.shellQuote(value)`),
+    `menu lists ${key} from omarchy-bg-live and hands it the picked id`)
+}
+assert(defaultById['appearance.live-background'].provider === 'background-sources'
+    && defaultById['appearance.live-background'].when === 'omarchy-cmd-present omarchy-bg-live',
+  'Live Background only shows with omarchy-bg-live installed')
+assert(defaultById['appearance.branding.screensaver'].provider === 'screensaver-sources'
+    && defaultById['appearance.branding.screensaver.text-effects'].action === 'omarchy-bg-live screensaver --set text',
+  'Screensaver lists the live screensavers next to the stock text effects')
+assert(/icon: \(value === current\) \? "✓" : \(parts\[4\] \|\| spec\.icon \|\| ""\)/.test(menuQml),
+  'a provider row can carry its own icon')
 assert(
   /function setActiveMenu\([\s\S]*?root\.invalidateVolatileProvider\(id\)\s*\n\s*root\.loadProviderForMenu\(id\)/.test(menuQml)
     && /function openExistingMenu\([\s\S]*?invalidateVolatileProvider\(activeMenu\)\s*\n\s*loadProviderForMenu\(activeMenu\)/.test(menuQml),
diff --git a/test/shell.d/screensaver-live-test.sh b/test/shell.d/screensaver-live-test.sh
new file mode 100755
index 000000000..67baadae0
--- /dev/null
+++ b/test/shell.d/screensaver-live-test.sh
@@ -0,0 +1,53 @@
+#!/bin/bash
+
+# The launcher hands the screensaver to omarchy-bg-live when a live one is
+# chosen, and keeps the stock text screensaver otherwise.
+
+set -euo pipefail
+
+source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/base-test.sh"
+
+tmpdir=$(mktemp -d)
+trap 'rm -rf "$tmpdir"' EXIT
+mkdir -p "$tmpdir/bin"
+
+# The stock path is cut short at the terminal check, so reaching it shows up
+# as a notification instead of terminals opening.
+printf '#!/bin/bash\nexit 1\n' >"$tmpdir/bin/pgrep"
+printf '#!/bin/bash\nexit 1\n' >"$tmpdir/bin/omarchy-toggle-enabled"
+printf '#!/bin/bash\necho DP-1\n' >"$tmpdir/bin/omarchy-hyprland-monitor-focused"
+printf '#!/bin/bash\necho unsupported.desktop\n' >"$tmpdir/bin/xdg-terminal-exec"
+printf '#!/bin/bash\necho stock >>"$TEST_DIR/calls"\n' >"$tmpdir/bin/omarchy-notification-send"
+cat >"$tmpdir/bin/omarchy-bg-live" <<'SH'
+#!/bin/bash
+if [[ $* == "screensaver --get" ]]; then
+  cat "$TEST_DIR/selected"
+else
+  echo "bg-live $*" >>"$TEST_DIR/calls"
+fi
+SH
+chmod +x "$tmpdir/bin/"*
+
+launch() {
+  : >"$tmpdir/calls"
+  PATH="$tmpdir/bin:$ROOT/bin:/usr/bin:/bin" TEST_DIR="$tmpdir" timeout 10 "$ROOT/bin/omarchy-launch-screensaver" "$@" || true
+  cat "$tmpdir/calls"
+}
+
+echo amiga >"$tmpdir/selected"
+[[ $(launch) == "bg-live screensaver" ]] || fail "a live screensaver runs through omarchy-bg-live" "$(launch)"
+pass "a live screensaver runs through omarchy-bg-live"
+
+[[ $(launch force) == "bg-live screensaver" ]] || fail "Preview runs the live screensaver too" "$(launch force)"
+pass "Preview runs the live screensaver too"
+
+[[ $(launch force text) == "stock" ]] || fail "force text still runs the stock screensaver" "$(launch force text)"
+pass "force text still runs the stock screensaver"
+
+echo text >"$tmpdir/selected"
+[[ $(launch) == "stock" ]] || fail "with Text Effects chosen the stock screensaver runs" "$(launch)"
+pass "with Text Effects chosen the stock screensaver runs"
+
+rm "$tmpdir/bin/omarchy-bg-live"
+[[ $(launch) == "stock" ]] || fail "without omarchy-bg-live the stock screensaver runs" "$(launch)"
+pass "without omarchy-bg-live the stock screensaver runs"
