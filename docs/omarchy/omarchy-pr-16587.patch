diff --git a/bin/omarchy-install-ambient b/bin/omarchy-install-ambient
new file mode 100755
index 000000000..aed159e11
--- /dev/null
+++ b/bin/omarchy-install-ambient
@@ -0,0 +1,13 @@
+#!/bin/bash
+
+# omarchy:summary=Install omarchy-ambient, for live backgrounds and live screensavers
+# omarchy:requires-sudo=true
+
+set -euo pipefail
+
+echo "Installing Ambient..."
+omarchy-pkg-add omarchy-ambient
+
+echo ""
+echo "Ambient has been installed. Pick a live background under Appearance > Live Background,"
+echo "and a live screensaver under Appearance > Branding > Screensaver."
diff --git a/bin/omarchy-launch-screensaver b/bin/omarchy-launch-screensaver
index 3db5acfe9..7e49b98cd 100755
--- a/bin/omarchy-launch-screensaver
+++ b/bin/omarchy-launch-screensaver
@@ -10,6 +10,15 @@ if omarchy-toggle-enabled screensaver-off && [[ $1 != "force" ]]; then
   exit 1
 fi
 
+# A live screensaver chosen under Appearance > Branding > Screensaver comes from
+# omarchy-ambient. It draws its own layers on every monitor, hides the cursor,
+# ends on the first activity or when the session locks, and keeps one running
+# at a time. "text" forces the stock one.
+if [[ ${2:-} != "text" ]] && omarchy-cmd-present omarchy-ambient &&
+  [[ $(omarchy-ambient screensaver --get 2>/dev/null) != "text" ]]; then
+  exec omarchy-ambient screensaver
+fi
+
 focused=$(omarchy-hyprland-monitor-focused)
 terminal=$(xdg-terminal-exec --print-id)
 
diff --git a/bin/omarchy-remove-ambient b/bin/omarchy-remove-ambient
new file mode 100755
index 000000000..04386b35b
--- /dev/null
+++ b/bin/omarchy-remove-ambient
@@ -0,0 +1,16 @@
+#!/bin/bash
+
+# omarchy:summary=Remove omarchy-ambient along with its settings and downloads, going back to the stock background and screensaver
+# omarchy:requires-sudo=true
+
+set -e
+
+omarchy-ambient stop 2>/dev/null || true
+omarchy-pkg-drop omarchy-ambient
+
+rm -rf \
+  "$HOME/.config/omarchy/ambient" \
+  "$HOME/.local/share/omarchy-ambient"
+
+echo ""
+echo "Ambient has been removed."
