From: =?UTF-8?q?Andr=C3=A9s=20Villagr=C3=A1n?= <andres@villagranquiroz.cl>
Date: Sun, 25 Oct 2026 06:00:11 -0300
Subject: [PATCH] Offer live backgrounds and screensavers from omarchy-bg-live

When omarchy-bg-live is installed, Appearance gets a Live Background menu
listing its background sources, and Branding > Screensaver lists its
screensaver sources next to the stock Text Effects, with a Preview. The
screensaver launcher hands over to omarchy-bg-live when a live screensaver
is chosen. Nothing changes without omarchy-bg-live.
---
 bin/omarchy-launch-screensaver        |  9 +++++
 default/i18n/en/menu.json             | 12 ++++++
 default/omarchy/omarchy-menu.jsonc    |  6 ++-
 shell/plugins/menu/Menu.qml           | 18 ++++++++-
 test/shell.d/menu-test.sh             | 20 +++++++++-
 test/shell.d/screensaver-live-test.sh | 53 +++++++++++++++++++++++++++
 6 files changed, 115 insertions(+), 3 deletions(-)
 create mode 100755 test/shell.d/screensaver-live-test.sh

diff --git a/bin/omarchy-launch-screensaver b/bin/omarchy-launch-screensaver
index 3db5acfe9..6f3c710cb 100755
--- a/bin/omarchy-launch-screensaver
+++ b/bin/omarchy-launch-screensaver
@@ -10,6 +10,15 @@ if omarchy-toggle-enabled screensaver-off && [[ $1 != "force" ]]; then
   exit 1
 fi
 
+# A live screensaver chosen under Appearance > Branding > Screensaver comes from
+# omarchy-bg-live. It draws its own layers on every monitor, hides the cursor,
+# ends on the first activity or when the session locks, and keeps one running
+# at a time. "text" forces the stock one.
+if [[ ${2:-} != "text" ]] && omarchy-cmd-present omarchy-bg-live &&
+  [[ $(omarchy-bg-live screensaver --get 2>/dev/null) != "text" ]]; then
+  exec omarchy-bg-live screensaver
+fi
+
 focused=$(omarchy-hyprland-monitor-focused)
 terminal=$(xdg-terminal-exec --print-id)
 
