diff --git a/shell/plugins/menu/Menu.qml b/shell/plugins/menu/Menu.qml
index 7189cce03..b7b6ca3e1 100644
--- a/shell/plugins/menu/Menu.qml
+++ b/shell/plugins/menu/Menu.qml
@@ -321,6 +321,22 @@ Item {
   // re-runs every time its submenu is entered, so a font installed since the
   // shell started shows up without restarting it.
   readonly property var providers: ({
+    // Live backgrounds and screensavers come from omarchy-bg-live, so a
+    // source the user adds shows up next to the bundled ones. Rows carry a
+    // description to search by, and their own icon. Choosing a screensaver
+    // installs and prepares it, so the idle timeout never has to.
+    "background-sources": {
+      script: "command -v omarchy-bg-live >/dev/null && omarchy-bg-live list background 2>/dev/null",
+      icon: "\udb83\ude09",
+      volatile: true,
+      actionFor: function(value) { return "omarchy-bg-live start " + Util.shellQuote(value) }
+    },
+    "screensaver-sources": {
+      script: "command -v omarchy-bg-live >/dev/null && omarchy-bg-live list screensaver 2>/dev/null",
+      icon: "\udb84\udd04",
+      volatile: true,
+      actionFor: function(value) { return "omarchy-bg-live screensaver --set " + Util.shellQuote(value) }
+    },
     "fonts": {
       script: "current=$(omarchy-font-current 2>/dev/null); omarchy-font-list 2>/dev/null | while read -r f; do [[ -z $f ]] && continue; printf '%s\\t%s\\t%s\\n' \"$f\" \"$f\" \"$current\"; done",
       icon: "",
@@ -453,7 +469,7 @@ Item {
         id: rowId,
         parent: menuId,
         kind: "action",
-        icon: (value === current) ? "✓" : (spec.icon || ""),
+        icon: (value === current) ? "✓" : (parts[4] || spec.icon || ""),
         label: label,
         title: "",
         target: "",
