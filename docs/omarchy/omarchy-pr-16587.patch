+// Live backgrounds and screensavers are omarchy-ambient sources: the rows
+// list whatever it has installed, and picking one hands it the source id.
+for (const [key, list, action] of [
+  ['background-sources', 'omarchy-ambient list background', 'omarchy-ambient start '],
+  ['screensaver-sources', 'omarchy-ambient list screensaver', 'omarchy-ambient screensaver --set ']
+]) {
+  const block = (providerBlock.match(new RegExp(`"${key}": \\{[\\s\\S]*?\\n    \\}`)) || [''])[0]
+  assert(block.includes(`command -v omarchy-ambient >/dev/null && ${list}`) && /volatile: true/.test(block) && block.includes(`"${action}" + Util.shellQuote(value)`),
