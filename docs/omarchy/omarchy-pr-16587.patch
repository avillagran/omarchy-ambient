diff --git a/bin/omarchy-launch-screensaver b/bin/omarchy-launch-screensaver
index 3db5acfe9..e13dc286c 100755
--- a/bin/omarchy-launch-screensaver
+++ b/bin/omarchy-launch-screensaver
@@ -10,6 +10,15 @@ if omarchy-toggle-enabled screensaver-off && [[ $1 != "force" ]]; then
   exit 1
 fi
 
+# The selected Amiga screensaver comes from
+# omarchy-ambient. It draws its own layers on every monitor, hides the cursor,
+# ends on the first activity or when the session locks, and keeps one running
+# at a time. "text" forces the stock one.
+if [[ ${2:-} != "text" ]] &&
+  [[ $(omarchy-ambient screensaver --get 2>/dev/null) != "text" ]]; then
+  exec omarchy-ambient screensaver
+fi
+
 focused=$(omarchy-hyprland-monitor-focused)
 terminal=$(xdg-terminal-exec --print-id)
 
