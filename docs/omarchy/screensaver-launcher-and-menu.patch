diff --git i/bin/omarchy-launch-screensaver w/bin/omarchy-launch-screensaver
index 197b313..34e04f7 100755
--- i/bin/omarchy-launch-screensaver
+++ w/bin/omarchy-launch-screensaver
@@ -3,23 +3,23 @@
 # omarchy:summary=Launch the selected Omarchy screensaver
 # omarchy:args=[force] [default]
 
-# Exit early if either screensaver backend is already running. The Amiga
-# controller's flock is the authority; its wrapper execs into Python.
+# Exit early if the screensaver is already running. A live screensaver keeps
+# its own lock, so a second omarchy-bg-live call exits at once too.
 pgrep -f '[o]rg.omarchy.screensaver' && exit 0
-amiga_lock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy-amiga-screensaver.lock"
-if [[ -f $amiga_lock ]] && ! flock -n "$amiga_lock" true; then
-  exit 0
-fi
 
 # Allow screensaver to be turned off but also force started
 if omarchy-toggle-enabled screensaver-off && [[ $1 != "force" ]]; then
   exit 1
 fi
 
-# Amiga owns its child session and input guard; the idle path never installs.
-if [[ ${2:-} != "text" && ${2:-} != "default" ]] && omarchy-setup-screensaver --is-amiga; then
+# A live screensaver (Amiga demos, ttfx effects, ...) comes from omarchy-bg-live.
+# It draws its own layers on every monitor, hides the cursor, ends on the first
+# activity or when the session locks, and never installs anything on the idle
+# path: choosing it in the menu prepared it already.
+if [[ ${2:-} != "text" && ${2:-} != "default" ]] && omarchy-cmd-present omarchy-bg-live &&
+  [[ $(omarchy-bg-live screensaver --get 2>/dev/null) != text ]]; then
   omarchy-shell -q shell hide omarchy.menu || true
-  exec omarchy-screensaver-amiga
+  exec omarchy-bg-live screensaver
 fi
 
 focused=$(omarchy-hyprland-monitor-focused)
