#!/bin/bash

# omarchy:summary=Run a live program (screensaver, Amiga demo, game...) as the background or the screensaver
# omarchy:args=list [background|screensaver] | start <source> [choice] | stop | status | run <source> [choice] | screensaver [--get | --set <source> | <source> [choice]] | omarchy install|uninstall|status | check <source-dir> | layer <command...>
# omarchy:examples=omarchy-bg-live start screensaver

# A live background is a program drawing behind the windows instead of a still
# or a video. Each one comes from a source: a directory with a source.conf and
# a run executable (see docs/creating-sources.md). While one runs, OWE is
# paused, and the program is stopped with SIGSTOP whenever nothing can see it:
# its output is off or shows a fullscreen window, the session is locked, or
# the computer runs on battery. Setting an ordinary background, or a theme,
# ends it.
#
# A source that lists screensaver in its placements can also run as the
# screensaver: over everything, with the keyboard to itself, until the user
# comes back or the session locks (see docs/screensaver-mode.md).

self=$(realpath "$0")
root=${self%/bin/*}

# A checkout runs in place; an install keeps its parts under share/ and lib/.
if [[ -d $root/sources ]]; then
  builtin_sources=$root/sources
  layer_lib=$root/build/omarchy-bg-live-layer.so
  dismiss_helper=$root/build/omarchy-bg-live-dismiss
else
  builtin_sources=$root/share/omarchy-bg-live/sources
  layer_lib=$root/lib/omarchy-bg-live/omarchy-bg-live-layer.so
  dismiss_helper=$root/lib/omarchy-bg-live/omarchy-bg-live-dismiss
fi
dismiss_helper=${OMARCHY_BG_LIVE_DISMISS:-$dismiss_helper}

CONFIG_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/bg-live
SOURCE_PATH=${OMARCHY_BG_LIVE_PATH:-$CONFIG_DIR/sources:$builtin_sources}
DATA_DIR=${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-bg-live
STATE_DIR=$HOME/.local/state/omarchy
LIVE_FILE=$STATE_DIR/bg-live
POWER_SUPPLIES=${OMARCHY_BG_LIVE_POWER_SUPPLIES:-/sys/class/power_supply}
UNIT=omarchy-bg-live
RUN_DIR=${XDG_RUNTIME_DIR:-/run/user/$UID}/omarchy-bg-live
# Held with flock by the running screensaver, and holding its pid, so a live
# background can tell it is covered.
SCREENSAVER_LOCK=$RUN_DIR/screensaver
SCREENSAVER_CONF=$CONFIG_DIR/screensaver.conf
# The first activity this soon after the screensaver starts doesn't end it.
GRACE_MS=${OMARCHY_BG_LIVE_GRACE_MS:-1000}

# Keys the supervisor reads itself; every other key in source.conf reaches the
# source as OMARCHY_BG_LIVE_SETTING_<KEY>.
RESERVED_KEYS=" name icon description order outputs pause on_battery needs packages placements input "

# Where the source runs: background (behind the windows) or screensaver.
placement=background

fail() {
  echo "$*" >&2
  notify-send -a omarchy-bg-live "Live background" "$*" 2>/dev/null
  exit 1
}

# The first directory on the path that has the source wins, so a user's own
# source replaces a bundled one with the same name.
source_dir() {
  local dir dirs
  IFS=: read -ra dirs <<<"$SOURCE_PATH"
  for dir in "${dirs[@]}"; do
    [[ -f $dir/$1/source.conf ]] && echo "$dir/$1" && return
  done
  return 1
}

source_ids() {
  local dir dirs conf
  IFS=: read -ra dirs <<<"$SOURCE_PATH"
  for dir in "${dirs[@]}"; do
    for conf in "$dir"/*/source.conf; do
      [[ -f $conf ]] && basename "${conf%/source.conf}"
    done
  done | awk '!seen[$0]++'
}

# key=value lines from the source's source.conf, then the user's
# ~/.config/omarchy/bg-live/<source>.conf, so a later line overrides.
settings_lines() {
  cat "$2/source.conf" "$CONFIG_DIR/$1.conf" 2>/dev/null |
    sed -n 's/^[[:space:]]*\([a-z][a-z0-9_]*\)[[:space:]]*=[[:space:]]*\(.*\)$/\1=\2/p' |
    sed 's/[[:space:]]*$//'
}

setting() {
  local value
  value=$(settings_lines "$1" "$2" | sed -n "s/^$3=//p" | tail -n 1)
  echo "${value:-$4}"
}

# A need is a command, or alternatives joined by | when any one will do.
missing_needs() {
  local need alternative met
  for need in $(setting "$1" "$2" needs); do
    met=false
    for alternative in ${need//|/ }; do
      command -v "$alternative" >/dev/null && met=true && break
    done
    $met || echo "$need"
  done
}

supports() {
  [[ " $(setting "$1" "$2" placements background) " == *" $3 "* ]]
}

# What prepare, pick and run see of their source.
export_source_env() {
  local key value
  export OMARCHY_BG_LIVE_SOURCE=$1 OMARCHY_BG_LIVE_SOURCE_DIR=$2
  export OMARCHY_BG_LIVE_PLACEMENT=$placement
  if [[ $placement == screensaver ]]; then
    export OMARCHY_BG_LIVE_LAYER=overlay OMARCHY_BG_LIVE_KEYBOARD=exclusive
  else
    export OMARCHY_BG_LIVE_LAYER=bottom OMARCHY_BG_LIVE_KEYBOARD=none
  fi
  export OMARCHY_BG_LIVE_DATA=$DATA_DIR/$1
  export OMARCHY_BG_LIVE_NAMESPACE=omarchy-bg-live-$1
  export OMARCHY_BG_LIVE_LAYER_LIB=$layer_lib
  export PATH="${self%/*}:$PATH"
  mkdir -p "$OMARCHY_BG_LIVE_DATA"

  while IFS='=' read -r key value; do
    [[ $RESERVED_KEYS == *" $key "* ]] || export "OMARCHY_BG_LIVE_SETTING_${key^^}=$value"
  done < <(settings_lines "$1" "$2")
}

# Installs what the source needs and prepares it (a first download, say).
# When something is missing and there are packages for it, they are installed
# in a terminal, which then runs the given command again; without a command,
# a missing need fails.
prepare_source() {
  local id=$1 dir missing packages
  shift

  dir=$(source_dir "$id") || fail "There is no live background named $id"
  missing=$(missing_needs "$id" "$dir")
  if [[ -n $missing ]]; then
    packages=$(setting "$id" "$dir" packages)
    if (($# > 0)) && [[ -n $packages ]] && command -v omarchy-launch-floating-terminal-with-presentation >/dev/null; then
      omarchy-launch-floating-terminal-with-presentation \
        "omarchy-pkg-add $packages && $(printf '%q ' "$self" "$@")" >/dev/null 2>&1 &
      return 1
    fi
    fail "$(setting "$id" "$dir" name "$id") needs $(echo $missing)"
  fi

  export_source_env "$id" "$dir"
  if [[ -x $dir/prepare ]]; then
    "$dir/prepare" >&2 || fail "$(setting "$id" "$dir" name "$id") could not be prepared"
  fi
}

# Prepares the source and lets the user pick what to show. Prints the choice,
# or fails when cancelled.
prepare_and_pick() {
  local id=$1 choice=$2 dir

  prepare_source "$id" start "$id" "$choice" || return 1
  dir=$OMARCHY_BG_LIVE_SOURCE_DIR
  if [[ -z $choice && -x $dir/pick ]]; then
    choice=$("$dir/pick") && [[ -n $choice ]] || return 1
  fi
  echo "$choice"
}

on_battery() {
  local supply mains=false
  for supply in "$POWER_SUPPLIES"/*; do
    [[ -r $supply/type && $(<"$supply/type") == Mains ]] || continue
    [[ $(<"$supply/online") == 1 ]] && return 1
    mains=true
  done
  $mains
}

# The running screensaver's pid is in its lock file. Reading the file never
# wakes a live background's watch on it, which only sees writes.
screensaver_running() {
  local pid
  read -r pid 2>/dev/null <"$SCREENSAVER_LOCK" && [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null
}

# The outputs where a background can be seen: none while the session is
# locked or the screensaver covers them, and none that is off or shows a
# fullscreen window. One hyprctl call answers all of it.
#
# A screensaver is on top of everything, fullscreen windows included, and
# only an output that is off hides it. It ends when the session locks, so it
# hears about that as a "locked" line.
visible_outputs() {
  if [[ $placement == screensaver ]]; then
    hyprctl -j monitors | jq -r '
      if any(.[]; (.solitaryBlockedBy // []) | index("LOCK")) then "locked"
      else .[] | select(.dpmsStatus != false) | .name
      end'
    return
  fi

  screensaver_running && return
  [[ $on_battery_mode == pause ]] && on_battery && return

  hyprctl -j --batch "monitors; workspaces" | jq -rs '
    .[0] as $monitors | .[1] as $workspaces
    | if any($monitors[]; (.solitaryBlockedBy // []) | index("LOCK")) then empty
      else $monitors[]
        | select(.dpmsStatus != false)
        | select(.activeWorkspace.id as $id | any($workspaces[]; .id == $id and .hasfullscreen) | not)
        | .name
      end'
}

# Every line is one event. A background hears about a new background or theme,
# and about the screensaver starting and ending. A screensaver hears from the
# dismiss helper ("ready", "activity", and "dismiss>>" when it exits).
events() {
  socat -u "UNIX-CONNECT:$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock" - &
  if [[ $PLACEMENT == screensaver ]]; then
    if [[ -n $DISMISS ]]; then
      { "$DISMISS" --grace "$GRACE_MS"; echo "dismiss>>$?"; } &
    fi
  else
    inotifywait -m -q -e create,moved_to --format 'background>>%f' "$STATE_DIR/current" &
    inotifywait -m -q -e close_write --format 'screensaver>>%f' "$RUN_DIR" &
  fi

  # Locking, monitors turning off and unplugging the charger send no event,
  # and a program that died gets restarted on the next tick. A screensaver
  # ticks faster, so it gives way to the lock screen promptly.
  while sleep "$TICK"; do echo tick; done &
  wait
}

# The outputs to cover: each monitor, the focused one, or a single program
# that covers every output itself (shown as *).
targets() {
  case $outputs in
    all) echo '*' ;;
    focused) hyprctl -j monitors | jq -r 'map(select(.focused))[0].name' ;;
    *) hyprctl -j monitors | jq -r '.[].name' ;;
  esac
}

launch() {
  local output=$1 width= height= scale= work

  if [[ $output != '*' ]]; then
    read -r width height scale < <(hyprctl -j monitors | jq -r --arg output "$output" '.[] | select(.name == $output) | "\(.width) \(.height) \(.scale)"')
    [[ -n $width ]] || return
  fi

  work=$runtime/${output/\*/all}
  mkdir -p "$work"

  OMARCHY_BG_LIVE_OUTPUT=${output#\*} OMARCHY_BG_LIVE_WIDTH=$width OMARCHY_BG_LIVE_HEIGHT=$height \
    OMARCHY_BG_LIVE_SCALE=$scale OMARCHY_BG_LIVE_RUNTIME=$work OMARCHY_BG_LIVE_CHOICE=$choice \
    setsid "$dir/run" ${choice:+"$choice"} </dev/null 8>&- &

  program[$output]=$!
  started[$output]=$SECONDS
  paused[$output]=false
  echo "started $id ${choice:+$choice }on $output"
}

# Each program runs as the leader of its own session; zombies don't count.
any_alive() {
  local pid
  for pid in "$@"; do
    ps -o stat= -s "$pid" 2>/dev/null | grep -qv '^Z' && return 0
  done
  return 1
}

# Asks the programs' process groups to end, and makes sure they did.
end_groups() {
  local pid i
  for pid in "$@"; do
    kill -CONT -- -"$pid" 2>/dev/null
    kill -TERM -- -"$pid" 2>/dev/null
  done
  for ((i = 0; i < 30; i++)); do
    any_alive "$@" || return 0
    sleep 0.1
  done
  for pid in "$@"; do
    kill -KILL -- -"$pid" 2>/dev/null
  done
}

finish() {
  [[ -n ${program[$1]} ]] || return
  end_groups "${program[$1]}"
  unset "program[$1]" "started[$1]" "paused[$1]" "failures[$1]"
  rm -rf "${runtime:?}/${1/\*/all}"
  echo "ended on $1"
}

# A program that keeps dying right after it starts is given up on.
restart() {
  local output=$1
  end_groups "${program[$output]}"

  if ((SECONDS - started[$output] < 10)); then
    failures[$output]=$((${failures[$output]:-0} + 1))
  else
    failures[$output]=0
  fi

  if ((failures[$output] >= 5)); then
    unset "program[$output]"
    echo "gave up on $output"
    ((${#program[@]} > 0)) || exit 1
  else
    echo "restarting on $output"
    launch "$output"
  fi
}

evaluate() {
  local output visible pid status

  for output in "${!program[@]}"; do
    pid=${program[$output]}
    [[ $(ps -o stat= -p "$pid" 2>/dev/null) == [^Z]* ]] && continue
    # A screensaver that handles input itself ends by exiting 0.
    if [[ $placement == screensaver && $input == own ]]; then
      wait "$pid"
      status=$?
      ((status == 0)) && echo "ended by $output" && exit 0
    fi
    restart "$output"
  done

  [[ $pause == stop || $placement == screensaver ]] || return
  visible=" $(visible_outputs | tr '\n' ' ') "
  [[ $visible == *" locked "* ]] && echo "the session locked" && exit 0

  for output in "${!program[@]}"; do
    pid=${program[$output]}
    if [[ $visible == *" $output "* || ($output == '*' && $visible != "  ") ]]; then
      ${paused[$output]} && kill -CONT -- -"$pid" && paused[$output]=false && echo "resumed on $output"
    else
      ${paused[$output]} || { kill -STOP -- -"$pid" && paused[$output]=true && echo "paused on $output"; }
    fi
  done
}

cursor() {
  hyprctl eval "hl.config({ cursor = { invisible = $1 } })" &>/dev/null ||
    hyprctl keyword cursor:invisible "$1" &>/dev/null
}

cleanup() {
  ((${#program[@]} > 0)) && end_groups "${program[@]}"
  [[ -n $listener ]] && kill -- -"$listener" 2>/dev/null
  $owe_paused && owe resume >/dev/null
  rm -rf "$runtime"
  if [[ $placement == screensaver ]]; then
    $cursor_hidden && cursor false
    # The write tells a frozen live background to look again.
    : >"$SCREENSAVER_LOCK"
  else
    rm -f "$LIVE_FILE"
  fi
  echo stopped
}

# Waits for the dismiss helper to listen, so a screensaver never covers the
# screen without a way to end it.
await_dismiss_helper() {
  local event deadline=$((SECONDS + 5))
  while ((SECONDS < deadline)) && read -r -t $((deadline - SECONDS)) event <&3; do
    case $event in
      ready) return 0 ;;
      dismiss\>\>*) break ;;
    esac
  done
  echo "the dismiss helper did not start" >&2
  exit 1
}

supervise() {
  id=$1 choice=$2 owe_paused=false cursor_hidden=false listener=
  declare -gA program=() started=() paused=() failures=()

  dir=$(source_dir "$id") || exit 1
  outputs=$(setting "$id" "$dir" outputs each)
  pause=$(setting "$id" "$dir" pause stop)
  on_battery_mode=$(setting "$id" "$dir" on_battery pause)
  input=$(setting "$id" "$dir" input dismiss)
  export_source_env "$id" "$dir"
  runtime=$(mktemp -d -t omarchy-bg-live.XXXXXX)
  mkdir -p "$RUN_DIR"

  # Leave OWE alone if the user paused it; it is theirs to resume. Under a
  # live background it is already paused, by that background.
  if command -v owe >/dev/null && ! { [[ $placement == screensaver ]] && status_id >/dev/null; } &&
    [[ $(owe status 2>/dev/null | jq -r '.manual_pause') != true ]] && owe pause >/dev/null 2>&1; then
    owe_paused=true
  fi

  local tick=5 dismiss=
  if [[ $placement == screensaver ]]; then
    tick=2
    [[ $input == own ]] || dismiss=$dismiss_helper
  fi
  exec 3< <(exec setsid bash -c "$(declare -f events); $(printf 'STATE_DIR=%q RUN_DIR=%q PLACEMENT=%q TICK=%q DISMISS=%q GRACE_MS=%q' \
    "$STATE_DIR" "$RUN_DIR" "$placement" "$tick" "$dismiss" "$GRACE_MS"); events" 8>&-)
  listener=$!

  trap cleanup EXIT
  trap 'exit 0' TERM INT
  if [[ $placement == screensaver ]]; then
    [[ -z $dismiss ]] || await_dismiss_helper
    cursor true && cursor_hidden=true
  else
    mkdir -p "$STATE_DIR"
    printf '%s %s\n' "$id" "$choice" >"$LIVE_FILE"
  fi

  local output
  while read -r output; do
    launch "$output"
  done < <(targets)
  ((${#program[@]} > 0)) || exit 1
  evaluate

  local event
  while read -r event <&3; do
    case $event in
      background\>\>background) exit 0 ;;
      activity) echo "the user is back" && exit 0 ;;
      dismiss\>\>*) echo "the dismiss helper ended" && exit 1 ;;
      monitoradded\>\>*) [[ $outputs == each ]] && launch "${event#*>>}" ;;
      monitorremoved\>\>*) finish "${event#*>>}" ;;
      fullscreen\>\>* | workspace\>\>* | focusedmon\>\>* | activespecial\>\>* | screensaver\>\>screensaver | tick) ;;
      *) continue ;;
    esac
    evaluate
  done
}

# The selected screensaver's id, or "text" for Omarchy's own.
screensaver_selected() {
  local id dir
  id=$(sed -n 's/^[[:space:]]*source[[:space:]]*=[[:space:]]*\([a-z0-9-]*\).*$/\1/p' "$SCREENSAVER_CONF" 2>/dev/null | tail -n 1)
  if [[ -n $id && $id != text ]] && dir=$(source_dir "$id") && supports "$id" "$dir" screensaver; then
    echo "$id"
  else
    echo text
  fi
}

# Selecting a source prepares it now, so the idle timeout never has to
# install or download anything.
select_screensaver() {
  local id=$1 dir temp
  if [[ $id != text ]]; then
    dir=$(source_dir "$id") || fail "There is no live screensaver named $id"
    supports "$id" "$dir" screensaver || fail "$(setting "$id" "$dir" name "$id") can't be a screensaver"
    placement=screensaver
    prepare_source "$id" screensaver --set "$id" || exit 0
  fi
  mkdir -p "$CONFIG_DIR"
  temp=$(mktemp "$SCREENSAVER_CONF.XXXXXX")
  echo "source=$id" >"$temp"
  mv -f "$temp" "$SCREENSAVER_CONF"
}

# Runs a screensaver in the foreground until the user is back. Only one runs
# at a time; another call while it runs does nothing.
run_screensaver() {
  local id=${1:-$(screensaver_selected)} choice=$2 dir
  [[ $id != text ]] || { echo "No live screensaver is selected" >&2; exit 1; }
  dir=$(source_dir "$id") || fail "There is no live screensaver named $id"
  supports "$id" "$dir" screensaver || fail "$(setting "$id" "$dir" name "$id") can't be a screensaver"
  [[ -x $dismiss_helper || $(setting "$id" "$dir" input dismiss) == own ]] ||
    fail "The dismiss helper is not built; run make in $root"

  mkdir -p "$RUN_DIR"
  exec 8>>"$SCREENSAVER_LOCK"
  flock -n 8 || exit 0
  echo $$ >"$SCREENSAVER_LOCK"
  # Until the supervisor's own cleanup takes over, a failed start still has
  # to release it.
  trap ': >"$SCREENSAVER_LOCK"' EXIT

  placement=screensaver
  prepare_source "$id" || exit 1
  supervise "$id" "$choice"
}

list() {
  local id dir current wanted=${1:-background}
  if [[ $wanted == screensaver ]]; then
    current=$(screensaver_selected)
  else
    current=$(status_id)
  fi
  while read -r id; do
    dir=$(source_dir "$id")
    supports "$id" "$dir" "$wanted" || continue
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(setting "$id" "$dir" order 50)" \
      "$(setting "$id" "$dir" name "$id")" "$id" "$current" \
      "$(setting "$id" "$dir" description)" "$(setting "$id" "$dir" icon)"
  done < <(source_ids) | sort -t $'\t' -k1,1n -k2,2 | cut -f2-
}

status_id() {
  local id
  systemctl --user -q is-active "$UNIT" && read -r id _ <"$LIVE_FILE" && echo "$id"
}

check() {
  local dir=${1%/} id problems=() value file
  id=$(basename "$dir")

  [[ $id =~ ^[a-z0-9][a-z0-9-]*$ ]] || problems+=("the directory name, $id, should be lowercase letters, digits and dashes")
  if [[ -f $dir/source.conf ]]; then
    [[ -n $(setting "$id" "$dir" name) ]] || problems+=("source.conf has no name")
    value=$(setting "$id" "$dir" outputs each)
    [[ $value =~ ^(each|focused|all)$ ]] || problems+=("outputs is $value, not each, focused or all")
    value=$(setting "$id" "$dir" pause stop)
    [[ $value =~ ^(stop|none)$ ]] || problems+=("pause is $value, not stop or none")
    value=$(setting "$id" "$dir" on_battery pause)
    [[ $value =~ ^(pause|run)$ ]] || problems+=("on_battery is $value, not pause or run")
    for value in $(setting "$id" "$dir" placements background); do
      [[ $value =~ ^(background|screensaver)$ ]] || problems+=("placements has $value, not background or screensaver")
    done
    value=$(setting "$id" "$dir" input dismiss)
    [[ $value =~ ^(dismiss|own)$ ]] || problems+=("input is $value, not dismiss or own")
    value=$(missing_needs "$id" "$dir")
    [[ -z $value ]] || problems+=("this computer lacks $(echo $value)")
  else
    problems+=("there is no source.conf")
  fi
  [[ -x $dir/run ]] || problems+=("run is missing or not executable")
  for file in pick prepare; do
    [[ ! -e $dir/$file || -x $dir/$file ]] || problems+=("$file is not executable")
  done

  if ((${#problems[@]} > 0)); then
    printf '%s\n' "${problems[@]/#/$id: }" >&2
    return 1
  fi
  echo "$id: ok"
}

# Omarchy integration for releases that don't offer live backgrounds and
# screensavers themselves yet. `omarchy install` adds the menu rows to the
# user's menu extension, between markers, and routes the idle screensaver
# through omarchy-bg-live with a clone of Omarchy's idle service. Both are
# skipped when Omarchy does it natively, and `omarchy uninstall` undoes them.
OMARCHY_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy
MENU_EXTENSION=$OMARCHY_DIR/extensions/omarchy-menu.jsonc
IDLE_ID=omarchy-bg-live.idle
IDLE_PLUGIN=$OMARCHY_DIR/plugins/$IDLE_ID
LAUNCHER=$DATA_DIR/omarchy/omarchy-launch-screensaver
MENU_BEGIN="// >>> omarchy-bg-live: added by \"omarchy-bg-live omarchy install\", removed by \"omarchy-bg-live omarchy uninstall\""
MENU_END="// <<< omarchy-bg-live"

omarchy_menu() {
  echo "${OMARCHY_PATH:-/usr/share/omarchy}/default/omarchy/omarchy-menu.jsonc"
}

# The menu ids differ between Omarchy releases: Style in 4.0, Appearance later.
menu_has() {
  grep -q "^[[:space:]]*\"$1\"[[:space:]]*:" "$(omarchy_menu)" 2>/dev/null
}

native_menu() {
  grep -q '"provider":"screensaver-sources"' "$(omarchy_menu)" 2>/dev/null
}

native_launcher() {
  grep -q 'omarchy-bg-live' "${OMARCHY_PATH:-/usr/share/omarchy}/bin/omarchy-launch-screensaver" 2>/dev/null
}

# One "id": {row} line per menu row, built with jq so every string is
# escaped properly.
menu_rows() {
  local style screensaver id dir name icon description
  if menu_has appearance.background; then style=appearance; else style=style; fi
  if menu_has appearance.branding.screensaver; then
    screensaver=appearance.branding.screensaver
  else
    screensaver=style.screensaver
  fi

  row() { jq -cn --arg id "$1" --arg label "$2" --arg icon "$3" --arg description "$4" --arg checked "$5" --arg action "$6" \
    '{($id): ({icon: $icon, label: $label, description: $description, checked: $checked, action: $action} | with_entries(select(.value != "")))}' |
    sed 's/^{\(.*\)}$/  \1,/'; }

  row "$style.live-background" "Live Background" "󰸉"
  row "$style.live-background.none" "None" "󰅖" "" "[[ \$($self status) == none ]]" "$self stop"
  while read -r id; do
    dir=$(source_dir "$id")
    supports "$id" "$dir" background || continue
    name=$(setting "$id" "$dir" name "$id") icon=$(setting "$id" "$dir" icon 󰸉) description=$(setting "$id" "$dir" description)
    row "$style.live-background.$id" "$name" "$icon" "$description" \
      "[[ \$($self status | cut -d ' ' -f 1) == $id ]]" "$self start $id"
  done < <(source_ids)

  row "$screensaver.live-text" "Text Effects" "󱄄" "The stock Omarchy screensaver" \
    "[[ \$($self screensaver --get) == text ]]" "$self screensaver --set text"
  while read -r id; do
    dir=$(source_dir "$id")
    supports "$id" "$dir" screensaver || continue
    name=$(setting "$id" "$dir" name "$id") icon=$(setting "$id" "$dir" icon 󱄄) description=$(setting "$id" "$dir" description)
    row "$screensaver.live-$id" "$name" "$icon" "$description" \
      "[[ \$($self screensaver --get) == $id ]]" "$self screensaver --set $id"
  done < <(source_ids)
  if ! native_launcher; then
    row "$screensaver.live-preview" "Preview" "" "" "" "$LAUNCHER force"
    row "system.screensaver" "Screensaver" "󱄄" "" "" "$LAUNCHER force"
  fi
}

# Drops the marked block from the menu extension, keeping everything else.
remove_menu_rows() {
  [[ -f $MENU_EXTENSION ]] || return 0
  local temp
  temp=$(mktemp "$MENU_EXTENSION.XXXXXX")
  BEGIN_MARK=$MENU_BEGIN END_MARK=$MENU_END awk '
    $0 == ENVIRON["BEGIN_MARK"] { skip = 1; next }
    $0 == ENVIRON["END_MARK"] { skip = 0; next }
    !skip' "$MENU_EXTENSION" >"$temp"
  mv -f "$temp" "$MENU_EXTENSION"
}

# Puts the block right after the extension's opening brace, so no line of the
# user's changes, and rows of their own with the same ids still win. The menu
# reads JSONC, which allows the trailing comma the block ends with.
add_menu_rows() {
  local rows=$1 temp
  mkdir -p "${MENU_EXTENSION%/*}"
  [[ -s $MENU_EXTENSION ]] || printf '{\n}\n' >"$MENU_EXTENSION"
  grep -q '^[[:space:]]*{' "$MENU_EXTENSION" || { echo "$MENU_EXTENSION has no opening brace; not touching it" >&2; return 1; }
  temp=$(mktemp "$MENU_EXTENSION.XXXXXX")
  # Through the environment: awk -v would take the backslashes in the rows
  # for escapes.
  BEGIN_MARK=$MENU_BEGIN END_MARK=$MENU_END ROWS=$rows awk '
    { print }
    !done && /^[[:space:]]*\{/ { print ENVIRON["BEGIN_MARK"]; print ENVIRON["ROWS"]; print ENVIRON["END_MARK"]; done = 1 }' \
    "$MENU_EXTENSION" >"$temp"
  mv -f "$temp" "$MENU_EXTENSION"
}

install_launcher() {
  mkdir -p "${LAUNCHER%/*}"
  cat >"$LAUNCHER" <<EOF
#!/bin/bash
# Installed by "omarchy-bg-live omarchy install"; "omarchy-bg-live omarchy uninstall" removes it.
# Runs the live screensaver when one is chosen, and Omarchy's own otherwise.
if omarchy-toggle-enabled screensaver-off && [[ \$1 != force ]]; then
  exit 1
fi
if [[ \${2:-} != text ]] && [[ \$($(printf %q "$self") screensaver --get 2>/dev/null) != text ]]; then
  exec $(printf %q "$self") screensaver
fi
exec omarchy-launch-screensaver "\$@"
EOF
  chmod 755 "$LAUNCHER"
}

# Another clone of the idle service (an older Amiga screensaver, the user's
# own) already replaces Omarchy's; two would both run screensavers.
other_idle_clone() {
  omarchy plugin list --json 2>/dev/null |
    jq -r --arg ours "$IDLE_ID" '.[] | select(.enabled and .clonedFrom == "omarchy.idle" and .id != $ours) | .id' | head -n 1
}

install_idle() {
  local source=${OMARCHY_PATH:-/usr/share/omarchy}/shell/plugins/services/idle stage other
  other=$(other_idle_clone)
  [[ -z $other ]] || { echo "The idle service is already replaced by $other; leaving it alone" >&2; return 1; }
  grep -q '|| omarchy-launch-screensaver")' "$source/Service.qml" 2>/dev/null ||
    { echo "This Omarchy's idle service is not one omarchy-bg-live knows how to route" >&2; return 1; }

  rm -rf "$IDLE_PLUGIN"
  mkdir -p "${IDLE_PLUGIN%/*}"
  stage=$(mktemp -d "${IDLE_PLUGIN%/*}/.omarchy-bg-live.XXXXXX")
  cp -aL "$source/." "$stage/"
  sed -i "s#|| omarchy-launch-screensaver\")#|| \\\\\"$LAUNCHER\\\\\"\")#" "$stage/Service.qml"
  jq --arg id "$IDLE_ID" '.id = $id | .name = "Idle (live screensavers)" |
    .omarchy = ((.omarchy // {}) + {clonedFrom: "omarchy.idle"})' "$stage/manifest.json" >"$stage/manifest.json.tmp"
  mv "$stage/manifest.json.tmp" "$stage/manifest.json"
  mv "$stage" "$IDLE_PLUGIN"

  omarchy-shell -q shell rescanPlugins
  local i
  for ((i = 0; i < 40; i++)); do
    omarchy plugin list --json 2>/dev/null | jq -e --arg id "$IDLE_ID" 'any(.[]; .id == $id)' >/dev/null && break
    sleep 0.1
  done
  omarchy plugin enable "$IDLE_ID" >/dev/null 2>&1
}

uninstall_idle() {
  [[ -d $IDLE_PLUGIN ]] || return 0
  omarchy plugin disable "$IDLE_ID" >/dev/null 2>&1
  rm -rf "$IDLE_PLUGIN"
  omarchy-shell -q shell rescanPlugins
  omarchy plugin enable omarchy.idle >/dev/null 2>&1
}

omarchy_install() {
  local rows
  remove_menu_rows
  if native_menu; then
    echo "menu: this Omarchy lists live backgrounds and screensavers itself"
  else
    rows=$(menu_rows) && add_menu_rows "$rows" && echo "menu: added to $MENU_EXTENSION"
  fi

  if native_launcher; then
    uninstall_idle
    echo "screensaver: this Omarchy hands over to omarchy-bg-live itself"
  else
    install_launcher
    if [[ -d $IDLE_PLUGIN ]] || install_idle; then
      echo "screensaver: the idle timeout runs $LAUNCHER"
    fi
  fi
}

omarchy_uninstall() {
  remove_menu_rows
  uninstall_idle
  rm -f "$LAUNCHER"
  rmdir "${LAUNCHER%/*}" 2>/dev/null
  echo "removed; Omarchy's own menu and idle service are back"
}

omarchy_status() {
  local menu=no idle=no
  grep -qxF "$MENU_BEGIN" "$MENU_EXTENSION" 2>/dev/null && menu=yes
  native_menu && menu=native
  [[ -d $IDLE_PLUGIN ]] && idle=yes
  native_launcher && idle=native
  echo "menu=$menu idle=$idle"
}

usage="Usage: omarchy-bg-live list [background|screensaver] | start <source> [choice] | stop | status | run <source> [choice] | screensaver [--get | --set <source> | <source> [choice]] | omarchy install|uninstall|status | check <source-dir> | layer <command...>"

case $1 in
  list)
    list "$2"
    ;;
  start)
    [[ -n $2 ]] || { echo "Usage: omarchy-bg-live start <source> [choice]" >&2; exit 1; }
    choice=$(prepare_and_pick "$2" "$3") || exit 0
    systemctl --user stop "$UNIT" 2>/dev/null
    systemd-run --user --quiet --collect --unit="$UNIT" -p KillMode=mixed -p TimeoutStopSec=10 \
      -E PATH="$PATH" -E WAYLAND_DISPLAY -E HYPRLAND_INSTANCE_SIGNATURE -E OMARCHY_PATH -E OMARCHY_BG_LIVE_PATH \
      "$self" supervise "$2" "$choice"
    ;;
  run)
    [[ -n $2 ]] || { echo "Usage: omarchy-bg-live run <source> [choice]" >&2; exit 1; }
    choice=$(prepare_and_pick "$2" "$3") || exit 0
    systemctl --user stop "$UNIT" 2>/dev/null
    supervise "$2" "$choice"
    ;;
  stop)
    systemctl --user stop "$UNIT" 2>/dev/null
    ;;
  status)
    if systemctl --user -q is-active "$UNIT" && [[ -f $LIVE_FILE ]]; then
      cat "$LIVE_FILE"
    else
      echo none
    fi
    ;;
  screensaver)
    case $2 in
      --get) screensaver_selected ;;
      --set)
        [[ -n $3 ]] || { echo "Usage: omarchy-bg-live screensaver --set <source|text>" >&2; exit 1; }
        select_screensaver "$3"
        ;;
      -*) echo "$usage" >&2; exit 1 ;;
      *) run_screensaver "$2" "$3" ;;
    esac
    ;;
  omarchy)
    case $2 in
      install) omarchy_install ;;
      uninstall) omarchy_uninstall ;;
      status) omarchy_status ;;
      *) echo "Usage: omarchy-bg-live omarchy install|uninstall|status" >&2; exit 1 ;;
    esac
    ;;
  check)
    [[ -n $2 ]] || { echo "Usage: omarchy-bg-live check <source-dir>" >&2; exit 1; }
    check "$2"
    ;;
  layer)
    shift
    [[ -r $layer_lib ]] || { echo "The layer library is not built; run make in $root" >&2; exit 1; }
    LD_PRELOAD="$layer_lib${LD_PRELOAD:+:$LD_PRELOAD}" exec "$@"
    ;;
  supervise)
    supervise "$2" "$3"
    ;;
  *)
    echo "$usage" >&2
    exit 1
    ;;
esac
