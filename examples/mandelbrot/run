#!/bin/bash

# omarchy-bg-live layer turns mpv's window into the background of the output
# the supervisor names.
exec omarchy-bg-live layer mpv --really-quiet --no-audio --no-osc --no-input-default-bindings \
  --loop=inf "av://lavfi:mandelbrot=size=${OMARCHY_BG_LIVE_SETTING_RESOLUTION:-640x360}:rate=25"
