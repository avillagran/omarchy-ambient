#!/bin/bash
set -eu
for name in OUTPUT WIDTH HEIGHT SCALE NAMESPACE LAYER KEYBOARD; do
  new=OMARCHY_AMBIENT_$name
  export "OMARCHY_BG_LIVE_$name=${!new}"
done
resolution=${OMARCHY_AMBIENT_SETTING_RESOLUTION:-auto}
if [[ $resolution == auto ]]; then
  width=${OMARCHY_AMBIENT_WIDTH:-1728}
  [[ $width =~ ^[0-9]+$ ]] || width=1728
  resolution=$(((width+432)/864))
  if ((resolution<1)); then resolution=1; fi
  if ((resolution>8)); then resolution=8; fi
fi
# The installed renderer wins: a link left for this source by an older
# install may point at a build without this scene. The link stands in only
# where no renderer is installed.
renderer=$(command -v omarchy-ttfx-layer) || renderer=$OMARCHY_AMBIENT_DATA/bin/omarchy-ttfx-layer
exec "$renderer" --interactive-eye --fps "${OMARCHY_AMBIENT_SETTING_FPS:-auto}" --resolution "$resolution"
