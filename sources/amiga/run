#!/bin/bash

# Plays demos in FS-UAE from the saved states the pack ships, so each starts
# on its first effect instead of the boot screens, muted.
#
# As a background it plays the chosen demo, or a random one without a choice.
# As a screensaver it plays the chosen demo first, then the others in a random
# order without repeats, each for as long as the pack measured it runs and at
# most max_demo_seconds. The next demo starts before the last one ends, so the
# desktop never shows between them.

demos=$OMARCHY_AMBIENT_DATA/demos

# The demos play muted, so FS-UAE does not need the sound server. It still
# opens a stream through OpenAL, and when the server has stopped answering,
# that blocks the start for the Pulse protocol's thirty seconds. Offer the
# server a short silent stream first; when it does not take it within two
# seconds, FS-UAE runs with OpenAL's null driver and starts at once.
sound_server_answers() {
  command -v paplay >/dev/null || return 0
  head -c 1600 /dev/zero |
    timeout 2 paplay --raw --format=s16le --channels=1 --rate=8000 --volume=0 2>/dev/null
}

# play <demo> <slot>: starts FS-UAE on the demo in the background. Two slots,
# so the next demo restores its state while the last one still shows.
play() {
  local config state=$OMARCHY_AMBIENT_RUNTIME/$2 audio=()
  config="$demos/$1/$(jq -r '.variants[0].config' "$demos/$1/config.json")"
  mkdir -p "$state"
  cp "${config%/*}"/state/*.uss "$state/Saved State 1.uss"
  sound_server_answers || audio=(ALSOFT_DRIVERS=null)

  # SDL would otherwise inhibit idle, keeping the lock screen away. FS-UAE
  # keeps its logs and caches under the source's data, not in ~/Documents.
  env SDL_VIDEODRIVER=wayland SDL_VIDEO_ALLOW_SCREENSAVER=1 "${audio[@]}" omarchy-ambient layer fs-uae "$config" \
    --base-dir="$OMARCHY_AMBIENT_DATA/fs-uae" --state-dir="$state" --load-state=1 --volume=0 \
    --fullscreen=0 --borderless=1 --keep-aspect=0 \
    --window-width="${OMARCHY_AMBIENT_WIDTH:-1920}" --window-height="${OMARCHY_AMBIENT_HEIGHT:-1080}" \
    --automatic-input-grab=0 --initial-input-grab=0 --keyboard-input-grab=0 &
}

# How long a demo plays: the pack's measurement, capped.
duration() {
  local seconds maximum=${OMARCHY_AMBIENT_SETTING_MAX_DEMO_SECONDS:-600}
  seconds=$(jq -r '.variants[0].playback.duration_seconds // empty' "$demos/$1/config.json")
  [[ $seconds =~ ^[0-9]+$ ]] && ((seconds < maximum)) && echo "$seconds" || echo "$maximum"
}

mapfile -t order < <(find "$demos" -mindepth 2 -maxdepth 2 -name config.json -printf '%h\n' | xargs -rn 1 basename | shuf)
((${#order[@]} > 0)) || { echo "There are no demos in $demos" >&2; exit 1; }
if [[ -r $demos/$1/config.json ]]; then
  order=("$1" $(printf '%s\n' "${order[@]}" | grep -vx "$1"))
fi

if [[ $OMARCHY_AMBIENT_PLACEMENT != screensaver ]]; then
  play "${order[0]}" 0
  wait $!
  exit
fi

shown=0 previous=
while :; do
  demo=${order[shown % ${#order[@]}]}
  play "$demo" $((shown % 2))
  current=$!
  if [[ -n $previous ]]; then
    sleep "${OMARCHY_AMBIENT_SETTING_TRANSITION_SECONDS:-3}"
    kill "$previous" 2>/dev/null
    wait "$previous"
  fi
  echo "playing $demo"

  sleep "$(duration "$demo")" &
  timer=$!
  wait -n "$current" "$timer"
  kill "$timer" 2>/dev/null
  # A demo that ended by itself leaves nothing to hand over from.
  previous=$current
  kill -0 "$current" 2>/dev/null || previous=
  shown=$((shown + 1))
done
