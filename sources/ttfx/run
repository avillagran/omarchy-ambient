#!/bin/bash

# One renderer per output. The output, its size, the layer, the keyboard mode
# and the namespace reach it through the OMARCHY_AMBIENT_* environment.

# A choice of fx:<effect> shows that one effect, as the selector offers them.
if [[ ${OMARCHY_AMBIENT_CHOICE:-} == fx:* ]]; then
  effect=${OMARCHY_AMBIENT_CHOICE#fx:}
  case $effect in
    bars|beams|binarypath|blackhole|bouncyballs|bubbles|burn|colorshift|crumble|decrypt|donut|errorcorrect|expand|fire|fireworks|highlight|laseretch|life|matrix|middleout|orbittingvolley|overflow|pour|print|rain|randomsequence|rings|scattered|slice|slide|smoke|spotlights|spray|starfield|swarm|sweep|synthgrid|thunderstorm|unstable|vhstape|wave|waves|wipe)
      OMARCHY_AMBIENT_SETTING_EFFECTS=$effect
      ;;
    *)
      echo "Unknown effect: $effect" >&2
      exit 1
      ;;
  esac
fi

args=(
  --effects "${OMARCHY_AMBIENT_SETTING_EFFECTS:-matrix,decrypt,rings,thunderstorm}"
  --rotate "${OMARCHY_AMBIENT_SETTING_ROTATE:-30}"
  --fps "${OMARCHY_AMBIENT_SETTING_FPS:-auto}"
  --resolution "${OMARCHY_AMBIENT_SETTING_RESOLUTION:-2}"
)
# An explicit source override wins; otherwise share Omarchy's text/image
# branding with the stock screensaver. Pass a path so newlines survive intact.
if [[ -n ${OMARCHY_AMBIENT_SETTING_TEXT_FILE:-} ]]; then
  args+=(--text-file "$OMARCHY_AMBIENT_SETTING_TEXT_FILE")
elif [[ -n ${OMARCHY_AMBIENT_SETTING_TEXT:-} ]]; then
  args+=(--text "$OMARCHY_AMBIENT_SETTING_TEXT")
elif [[ -f $HOME/.config/omarchy/branding/screensaver.txt ]]; then
  args+=(--text-file "$HOME/.config/omarchy/branding/screensaver.txt")
else
  args+=(--text OMARCHY)
fi

[[ ${OMARCHY_AMBIENT_SETTING_AUDIO:-0} == 1 ]] && args+=(--audio)

# omarchy-ttfx-layer still reads them under the engine's former name,
# omarchy-bg-live.
for name in OUTPUT WIDTH HEIGHT SCALE NAMESPACE LAYER KEYBOARD; do
  new=OMARCHY_AMBIENT_$name
  export "OMARCHY_BG_LIVE_$name=${!new}"
done

exec "$OMARCHY_AMBIENT_DATA/bin/omarchy-ttfx-layer" "${args[@]}"
