#!/bin/bash

# The effects loop of omarchy-screensaver, without its exit on input: random
# ttfx effects on the branding text, one after another.

text=${OMARCHY_BG_LIVE_SETTING_TEXT:-$HOME/.config/omarchy/branding/screensaver.txt}

printf '\033]11;rgb:00/00/00\007\033[?25l'

# ttfx measures the terminal once, so wait for the compositor's size to land.
deadline=$((SECONDS + 2))
while ((SECONDS < deadline)) && [[ $(stty size 2>/dev/null) == "24 80" ]]; do
  sleep 0.02
done

while :; do
  ttfx -i "$text" --frame-rate "${OMARCHY_BG_LIVE_SETTING_FPS:-30}" \
    --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c \
    --random-effect --no-eol --no-restore-cursor
done
